{
  "appId": "app.kyivlive.board",
  "appName": "基辅民生信息",
  "webDir": "www",
  "bundledWebRuntime": false,
  "loggingBehavior": "none",
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#F5F6F8"
  },
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#F5F6F8"
    }
  }
}
