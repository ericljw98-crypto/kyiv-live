# 复制为 .env 后填写。.env 不会被打进 APK，也不会提交到版本库。

# 本机快照生成与预览服务的端口与监听地址（默认 8787 / 127.0.0.1，仅本机可访问）
PORT=8787
HOST=127.0.0.1

# 可选。alerts.in.ua 官方 API 的个人 token。
# 申请表单：https://alerts.in.ua/api-request （内嵌 Tally 表单，人工审核，通常 24 小时、最多 7 天，token 邮件发送）
# 申请须用乌克兰语 / 波兰语 / 英语，用自己的话说明用途；官方明确拒绝 LLM 代写与一句话说明。
# 接口文档：https://devs.alerts.in.ua/ ，填好后运行 npm run check:token 验证。
# 限流软限 8-10 次/分、硬限 12 次/分；公开服务必须经本代理转发。
# 切勿把 token 写进 www/ 目录、APK 或版本库。
ALERTS_UA_TOKEN=

# 停电分组与地址在应用「设置」中选择，保存在设备本地，无需在此配置。

# 可选。上游请求超时（毫秒）
UPSTREAM_TIMEOUT=8000
